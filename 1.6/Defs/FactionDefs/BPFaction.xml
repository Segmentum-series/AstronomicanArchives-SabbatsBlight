<?xml version="1.0" encoding="utf-8" ?>
<Defs>

      <FactionDef ParentName="FactionBase" Name="CVN_BP_ChaosFactionBase" Abstract="True">
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <settlementGenerationWeight>1</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxCountAtGameStart>1</maxCountAtGameStart>
        <canMakeRandomly>true</canMakeRandomly>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
		<leaderTitle>Etogaur</leaderTitle>
		<fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
		<ideoName MayRequire="Ludeon.RimWorld.Ideology">Cult of Khorne</ideoName>
		<ideoDescription MayRequire="Ludeon.RimWorld.Ideology">The tribes of the Sabbat Worlds worship Khorne, sometimes called Kharneth, the lord of blood and rage. Khorne is said to rule his domain in the warp from atop a throne of skulls, and the tribes of the Sanguinary Worlds - to use their own term - worship him in various aspects. Although some devotees of Khorne can devolve into mindless violence - Khorne cares not whence the blood flows, after all - the Sanguinary Tribes have maintained a functioning if brutal society for millennia, long before the arrival of the Imperium, who are in many ways no less brutal.</ideoDescription>
		<deityPresets MayRequire="Ludeon.RimWorld.Ideology">
			<li>
				<nameType>
					<name>Khorne</name>
					<type>God of Blood</type>
				</nameType>
				<gender>Male</gender>
				<iconPath>UI/Deities/DeityGeneric</iconPath>
			</li>
		</deityPresets>
		<forcedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
		</forcedMemes>
		<requiredPreceptsOnly MayRequire="Ludeon.RimWorld.Ideology">false</requiredPreceptsOnly>
		<structureMemeWeights>
			<Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistAbstract>
		</structureMemeWeights>
		<disallowedPrecepts>
			<li MayRequire="Ludeon.RimWorld.Ideology">Skullspike_Disapproved</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Execution_Horrible</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Execution_Abhorrent</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_Prohibited</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Disapproved</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Horrible</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Abhorrent</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">NobleDespisedWeapons</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Cannibalism_Abhorrent</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Cannibalism_Disapproved</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">OrganUse_Abhorrent</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">OrganUse_HorribleNoSell</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">OrganUse_HorribleSellOK</li>
		</disallowedPrecepts>
        <raidCommonalityFromPointsCurve>
            <points>
                <li>(0, 1)</li> <!--Constant 1 at all points levels-->
            </points>
        </raidCommonalityFromPointsCurve>
          <disallowedRaidAgeRestrictions>
            <li MayRequire="Ludeon.RimWorld.Biotech">Children</li>
        </disallowedRaidAgeRestrictions>
    </FactionDef>

  <FactionDef ParentName="CVN_BP_ChaosFactionBase">
    <defName>CVN_BP_Bloodpactfaction</defName>
    <label>Blood Pact</label>
    <description>A highly organised Chaos cult devoted to Khorne, the god of Blood, Rage, and Hatred. The Blood Pact fights like a disciplined army, similar in training and organisation to the Imperial Guard, rather than the disorganised irregular forces that define most cults. They are named after the ritual in which they are sworn to the service of the Archon, the leader of the Pact.</description>
    <configurationListOrderPriority>990</configurationListOrderPriority>
    <basicMemberKind>CVN_BP_Initiate</basicMemberKind>
    <leaderTitle>Etogaur</leaderTitle>
    <pawnSingular>warrior</pawnSingular>
    <pawnsPlural>warriors</pawnsPlural>
    <techLevel>Industrial</techLevel>
    <permanentEnemyToEveryoneExcept>
      <li>CVN_BP_Bloodpact_Player</li>
      <li>PlayerTribe</li>
      <li>OutlanderRough</li>
      <li>TribeRough</li>
      <li MayRequire="redacted.segmentum.warrantofthevoid">Seg_WOTV_ImperiumPirates</li>
      <li MayRequire="shadow.rimdark.hereticfactions">SHAD_HereticFaction</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Beggars</li>
      <li MayRequire="Ludeon.RimWorld.Odyssey">TradersGuild</li>
    </permanentEnemyToEveryoneExcept>
    <factionNameMaker>CVN_BP_NamerFactionBloodPact</factionNameMaker>
    <settlementNameMaker>CVN_BP_NamerSettlementBloodPact</settlementNameMaker>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <factionIconPath>UI/Icons/CVN_BP_BP_BloodPactFactionIcon</factionIconPath>
    <colorSpectrum>
      <li>(0.54, 0.17, 0.16)</li>
    </colorSpectrum>
    <allowedCultures><li>CVN_BP_BloodPact</li></allowedCultures>
    <backstoryFilters>
      <li>
        <categories>
		  <li>CVN_BP_BloodPactChildBackstories</li>
          <li>CVN_BP_BloodPactBackstories</li>
        </categories>
      </li>
    </backstoryFilters>
    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
    <apparelStuffFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>Leather_Plain</li>
        <li>Leather_Human</li>
        <li>Steel</li>
      </thingDefs>
    </apparelStuffFilter>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
        </points>
      </maxPawnCostPerTotalPointsCurve>
        <pawnGroupMakers>
			<!--Traitor Guard-->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>0.8</commonality>
                <options>
                  <CVN_BP_Initiate>10</CVN_BP_Initiate>
                  <CVN_BP_TraitorGuardMelee>4</CVN_BP_TraitorGuardMelee>
                  <CVN_BP_TraitorGuardRanged>10</CVN_BP_TraitorGuardRanged>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
            </li>
			
			<!--General Blood Pact force-->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                  <CVN_BP_Initiate>10</CVN_BP_Initiate>
                  <CVN_BP_TraitorGuardMelee>3</CVN_BP_TraitorGuardMelee>
                  <CVN_BP_TraitorGuardRanged>8</CVN_BP_TraitorGuardRanged>
                  <CVN_BP_Sirdar_Melee>3</CVN_BP_Sirdar_Melee>
                  <CVN_BP_Sirdar_Ranged>8</CVN_BP_Sirdar_Ranged>
                  <CVN_BP_Sirdar_Gunner>2</CVN_BP_Sirdar_Gunner>
                  <CVN_BP_Sirdar_sniper>2</CVN_BP_Sirdar_sniper>
                  <CVN_BP_DeathBrigade_Melee>3</CVN_BP_DeathBrigade_Melee>
                  <CVN_BP_DeathBrigade_Ranged>6</CVN_BP_DeathBrigade_Ranged>
                  <CVN_BP_DeathBrigade_Gunner>2</CVN_BP_DeathBrigade_Gunner>
                  <CVN_BP_DeathBrigade_Demo>2</CVN_BP_DeathBrigade_Demo>
                  <CVN_BP_KhorneBerzerker>2</CVN_BP_KhorneBerzerker>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
            </li>
			
			<!--Sirdar group-->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                  <CVN_BP_Initiate>8</CVN_BP_Initiate>
                  <CVN_BP_TraitorGuardMelee>2</CVN_BP_TraitorGuardMelee>
                  <CVN_BP_TraitorGuardRanged>5</CVN_BP_TraitorGuardRanged>
                  <CVN_BP_Sirdar_Melee>4</CVN_BP_Sirdar_Melee>
                  <CVN_BP_Sirdar_Ranged>10</CVN_BP_Sirdar_Ranged>
                  <CVN_BP_Sirdar_Gunner>2</CVN_BP_Sirdar_Gunner>
                  <CVN_BP_Sirdar_sniper>2</CVN_BP_Sirdar_sniper>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
            </li>
			
			<!--Death Brigade-->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>0.4</commonality>
                <options>
                  <CVN_BP_DeathBrigade_Melee>6</CVN_BP_DeathBrigade_Melee>
                  <CVN_BP_DeathBrigade_Ranged>10</CVN_BP_DeathBrigade_Ranged>
                  <CVN_BP_DeathBrigade_Gunner>4</CVN_BP_DeathBrigade_Gunner>
                  <CVN_BP_DeathBrigade_Demo>2</CVN_BP_DeathBrigade_Demo>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
            </li>
			
			<!--Berzerkers-->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>0.2</commonality>
                <options>
                  <CVN_BP_Initiate>5</CVN_BP_Initiate>
                  <CVN_BP_KhorneBerzerker>5</CVN_BP_KhorneBerzerker>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
            </li>
			
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                  <CVN_BP_Initiate>10</CVN_BP_Initiate>
                  <CVN_BP_TraitorGuardMelee>3</CVN_BP_TraitorGuardMelee>
                  <CVN_BP_TraitorGuardRanged>8</CVN_BP_TraitorGuardRanged>
                  <CVN_BP_Sirdar_Melee>3</CVN_BP_Sirdar_Melee>
                  <CVN_BP_Sirdar_Ranged>8</CVN_BP_Sirdar_Ranged>
                  <CVN_BP_Sirdar_Gunner>2</CVN_BP_Sirdar_Gunner>
                  <CVN_BP_Sirdar_sniper>2</CVN_BP_Sirdar_sniper>
                  <CVN_BP_DeathBrigade_Melee>3</CVN_BP_DeathBrigade_Melee>
                  <CVN_BP_DeathBrigade_Ranged>6</CVN_BP_DeathBrigade_Ranged>
                  <CVN_BP_DeathBrigade_Gunner>2</CVN_BP_DeathBrigade_Gunner>
                  <CVN_BP_DeathBrigade_Demo>2</CVN_BP_DeathBrigade_Demo>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
            </li>

              <li>
                <kindDef>Settlement</kindDef>
                <commonality>1</commonality>
                <options>
                  <CVN_BP_Initiate>10</CVN_BP_Initiate>
                  <CVN_BP_TraitorGuardMelee>3</CVN_BP_TraitorGuardMelee>
                  <CVN_BP_TraitorGuardRanged>8</CVN_BP_TraitorGuardRanged>
                  <CVN_BP_Sirdar_Melee>3</CVN_BP_Sirdar_Melee>
                  <CVN_BP_Sirdar_Ranged>8</CVN_BP_Sirdar_Ranged>
                  <CVN_BP_Sirdar_Gunner>2</CVN_BP_Sirdar_Gunner>
                  <CVN_BP_Sirdar_sniper>2</CVN_BP_Sirdar_sniper>
                  <CVN_BP_DeathBrigade_Melee>3</CVN_BP_DeathBrigade_Melee>
                  <CVN_BP_DeathBrigade_Ranged>6</CVN_BP_DeathBrigade_Ranged>
                  <CVN_BP_DeathBrigade_Gunner>2</CVN_BP_DeathBrigade_Gunner>
                  <CVN_BP_DeathBrigade_Demo>2</CVN_BP_DeathBrigade_Demo>
                  <CVN_BP_KhorneBerzerker>2</CVN_BP_KhorneBerzerker>
                  <CVN_BP_Arnogaur>1</CVN_BP_Arnogaur>
                </options>
              </li>
          </pawnGroupMakers>

      <allowedArrivalTemperatureRange>-10~45</allowedArrivalTemperatureRange>
  </FactionDef>

  <FactionDef ParentName="PlayerFactionBase">
    <defName>CVN_BP_Bloodpact_Player</defName>
    <label>Blood Pact</label>
    <description>A Blood Pact warband operating on the Rimworld.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>CVN_BP_Sirdar_Ranged</basicMemberKind>
    <pawnSingular>warrior</pawnSingular>
    <pawnsPlural>warriors</pawnsPlural>
    <techLevel>Industrial</techLevel>
    <factionNameMaker>CVN_BP_NamerFactionBloodPact</factionNameMaker>
    <settlementNameMaker>CVN_BP_NamerSettlementBloodPact</settlementNameMaker>
    <allowedCultures><li>CVN_BP_BloodPact</li></allowedCultures>
    <backstoryFilters>
      <li>
        <categories>
          <li>CVN_BP_BloodPactBackstories</li>
        </categories>
      </li>
    </backstoryFilters>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <colorSpectrum>
      <li>(0.54, 0.17, 0.16)</li>
    </colorSpectrum>
    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
    <apparelStuffFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>Leather_Plain</li>
        <li>Leather_Human</li>
        <li>Steel</li>
      </thingDefs>
    </apparelStuffFilter>
  </FactionDef>
</Defs>