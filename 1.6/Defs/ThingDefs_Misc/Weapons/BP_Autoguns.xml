	<ThingDef ParentName="CVN_BP_AutogunBase">
        <defName>CVN_BP_Gun_AutoPistol</defName>
        <label>Pact autopistol</label>
        <description>A simple autopistol, unimpressive and weak. The autopistol's main benefit is its high rate of fire, ease of production, and low maintenance requirements.\n\nPact pistols don't have many notable changes besides heretical markings, being such a commonly distributed weapon that none of its users hold particular attachment to them.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/BP_Autopistol</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.4</drawSize>
        </graphicData>
        <uiIconScale>2</uiIconScale>
        <soundInteract>Interact_Autopistol</soundInteract>
        <recipeMaker>
            <researchPrerequisites>
            <li>CVN_BP_Basic</li>
            </researchPrerequisites>
        <recipeUsers Inherit="false">
