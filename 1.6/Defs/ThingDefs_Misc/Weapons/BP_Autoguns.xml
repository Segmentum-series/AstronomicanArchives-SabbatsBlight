	<!-- Autogun -->
	<ThingDef ParentName="CVN_BP_AutogunBase">
		<defName>CVN_BP_Gun_AutoGun</defName>
		<label>Pact autogun</label>
		<description>Automatic weapons usually issued to planetary defence forces. Autoguns, while weaker than lasguns, are far cheaper to produce and maintain.\n\nBlood Pact autoguns appear to pull from ancient terran designs involving historical revolts and uprisings, fitting for their own self-image.\n\nThis specific model is tooled for higher accuracy.</description>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/BP_Autogun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.4</drawSize>
		</graphicData>
		<uiIconScale>0.9</uiIconScale>
		<recipeMaker>
			<researchPrerequisites Inherit="False">
			<li>CVN_BP_Basic</li>
			<li>GasOperation</li>
			</researchPrerequisites>
            <researchPrerequisite Inherit="False">
	        </researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>CVN_BP_FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<displayPriority>427</displayPriority>
		</recipeMaker>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>42500</WorkToMake>
			<Mass>4</Mass>
			<AccuracyTouch>0.60</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.55</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>70</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CVN_BP_Bullet_AutoGun</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>30.9</range>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>12</ticksBetweenBurstShots>
				<soundCast>Shot_AssaultRifle</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<weaponTags>
			<li>CVN_BP_ranged1</li>
		</weaponTags>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
				<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>bayonet</label>
				<capacities>
				<li>Cut</li>
				</capacities>
				<power>13</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>
	
