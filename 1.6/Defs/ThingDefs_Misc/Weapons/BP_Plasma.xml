	<ThingDef ParentName="BaseHumanMakeableGun">
        <defName>CVN_BP_Gun_Melta</defName>
        <label>Pact meltagun</label>
        <description>A human-sized melta gun. Melta weaponry can turn the strongest metals into heaps of molten slag with superheated fusion blasts. \n\nMelta guns are highly valued by the Pact for tank hunter squads. Demand has only increased since the Pact's defeat on Urdesh.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/BP_Meltagun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.4</drawSize>
        </graphicData>
		<uiIconScale>1</uiIconScale>
        <soundInteract>Interact_Rifle</soundInteract>
        <recipeMaker>
		    <researchPrerequisites>
			 <li>CVN_BP_HeatWeapons</li>
			 <li>AdvancedFabrication</li>
	        </researchPrerequisites>
            <researchPrerequisite Inherit="False">
	        </researchPrerequisite>
			<recipeUsers Inherit="false">
                <li>CVN_BP_FabricationBench</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>9</Crafting>
            </skillRequirements>
            <displayPriority>434</displayPriority>
        </recipeMaker>
        <statBases>
            <WorkToMake>67500</WorkToMake>
            <Mass>10</Mass>
            <AccuracyTouch>0.60</AccuracyTouch>
            <AccuracyShort>0.75</AccuracyShort>
            <AccuracyMedium>0.70</AccuracyMedium>
            <AccuracyLong>0.65</AccuracyLong>
            <RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
        </statBases>
		<equippedStatOffsets>
            <MoveSpeed>-0.20</MoveSpeed>
		</equippedStatOffsets>
		<equippedAngleOffset>45</equippedAngleOffset>
        <costList>
            <Steel>100</Steel>
			<Plasteel>100</Plasteel>
            <ComponentIndustrial>8</ComponentIndustrial>
            <ComponentSpacer>3</ComponentSpacer>
        </costList>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Projectile_CVN_BP_Melta</defaultProjectile>
                <warmupTime>2.5</warmupTime>
                <range>12.9</range>
                <soundCast>ChargeLance_Fire</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
		<weaponTags Inherit="False">
            <li>CVN_BP_ranged4</li>
        </weaponTags>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
	
	<ThingDef ParentName="BaseBullet">
        <defName>Projectile_CVN_BP_Melta</defName>
        <label>melta blast</label>
        <description>a laser</description>
        <thingClass>taranchuk_lasers.LaserProjectile</thingClass>
        <drawOffscreen>true</drawOffscreen>
        <seeThroughFog>true</seeThroughFog>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Projectiles/Melta_Projectile</texPath>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>1.5</drawSize>
        </graphicData>
        <projectile>
            <damageDef>CVN_BP_MeltaDamage</damageDef>
            <damageAmountBase>25</damageAmountBase>
            <armorPenetrationBase>1</armorPenetrationBase>
            <stoppingPower>1.2</stoppingPower>
            <speed>1000</speed>
        </projectile>
        <modExtensions>
            <li Class="taranchuk_lasers.LaserProperties">
                <damageTickRate>6</damageTickRate>
                <lifetimeTicks>18</lifetimeTicks>
                <beamWidth>1</beamWidth>
                <beamWidthDrawScale>1</beamWidthDrawScale>
                <sweepRatePerTick>0</sweepRatePerTick>
                <maxSweepAngle>0</maxSweepAngle>
                <damageThingsAcrossBeamLine>false</damageThingsAcrossBeamLine>
                <debugCells>false</debugCells>
                <textureScrollOffsetPerTick>(0, -0.1)</textureScrollOffsetPerTick>
                <lockOnTarget>false</lockOnTarget>
            </li>
        </modExtensions>
    </ThingDef>


	<DamageDef ParentName="Bullet">
		<defName>CVN_BP_MeltaDamage</defName>
		<label>melta burn</label>
		<workerClass>DamageWorker_AddInjury</workerClass>
		<armorCategory>Heat</armorCategory>
		<hediff>Shredded</hediff>
		<deathMessage>{0} was melted into a pile of flesh and slag.</deathMessage>
		<impactSoundType>Electric</impactSoundType>
		<defaultArmorPenetration>2.0</defaultArmorPenetration>
	</DamageDef>

	<DamageDef>
		<defName>CVN_BP_PlasDamage</defName>
		<label>plasma burn</label>
		<workerClass>DamageWorker_AddInjury</workerClass>
		<impactSoundType>Bullet</impactSoundType>
		<soundExplosion>Explosion_EMP</soundExplosion>
		<externalViolence>true</externalViolence>
		<hediff>Shredded</hediff>
		<armorCategory>Heat</armorCategory>
		<deathMessage>{0} has been shown the power of the sun.</deathMessage>
	</DamageDef>
</Defs>
