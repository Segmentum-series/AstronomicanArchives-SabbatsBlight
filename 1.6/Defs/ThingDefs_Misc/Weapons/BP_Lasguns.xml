	<ThingDef ParentName="CVN_BP_LasgunBase">
        <defName>CVN_BP_Gun_LongLasgun</defName>
        <label>Pact longlas</label>
        <description>A lasgun that has been altered for long range engagement.\n\nMembers of the Pact equipped with these lack the common hand scars seen with other believers. This is due to the Archon allowing snipers to cut other parts of flesh during initiation, so as not to impair their aim.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/BP_Longlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		    <drawSize>1.4</drawSize>
