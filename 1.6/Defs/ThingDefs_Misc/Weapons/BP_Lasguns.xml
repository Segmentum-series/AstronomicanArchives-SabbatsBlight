            <texPath>Things/Item/Equipment/WeaponRanged/BP_Laspistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.4</drawSize>
        </graphicData>
		<uiIconScale>1.6</uiIconScale>
		<soundInteract>Interact_ChargeRifle</soundInteract>
        <statBases>
            <WorkToMake>38000</WorkToMake>
            <Mass>4</Mass>
            <AccuracyTouch>0.90</AccuracyTouch>
            <AccuracyShort>0.85</AccuracyShort>
            <AccuracyMedium>0.65</AccuracyMedium>
            <AccuracyLong>0.60</AccuracyLong>
            <RangedWeapon_Cooldown>1.35</RangedWeapon_Cooldown>
        </statBases>
        <weaponTags>
            <li>CVN_BP_ranged2</li>
            <li>CVN_BP_Lasguns</li>
         </weaponTags>
        <costList>
          <Steel>65</Steel>
          <ComponentIndustrial>4</ComponentIndustrial>
         </costList>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Projectile_CVN_BP_Laspistol</defaultProjectile>
                <warmupTime>1</warmupTime>
                <range>23.9</range>
                <soundCast>CVN_BP_LasgunFire</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
            </li>
        </verbs>
        <recipeMaker>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
            <recipeUsers Inherit="false">
                <li>CVN_BP_FabricationBench</li>
            </recipeUsers>
            <displayPriority>232</displayPriority>
			<researchPrerequisites>
                <li>CVN_BP_Basic</li>
	        </researchPrerequisites>
        </recipeMaker>
        <tools>
            <li>
                <label>grip</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
	
