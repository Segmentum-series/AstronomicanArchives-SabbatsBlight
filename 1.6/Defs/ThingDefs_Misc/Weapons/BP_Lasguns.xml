<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef Abstract="true" Name="CVN_BP_LasgunBase" ParentName="BaseHumanMakeableGun">
        <techLevel>Spacer</techLevel>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_ChargeRifle</soundInteract>
        <weaponTags Inherit="False">
        </weaponTags>
        <tradeTags Inherit="False">
            <li>CVN_BP_Ranged</li>
        </tradeTags>
        <thingSetMakerTags>
          <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <recipeMaker>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
            <researchPrerequisites>
		     <li>GasOperation</li>
		     <li>Batteries</li>
		    </researchPrerequisites>
            <researchPrerequisite Inherit="False">
	        </researchPrerequisite>
            <recipeUsers Inherit="false">
                <li>HP_AM_MilitarumFabricationBench</li>
            </recipeUsers>
            <displayPriority>200</displayPriority>
        </recipeMaker>
    </ThingDef>

	<DamageDef ParentName="Bullet">
		<defName>CVN_BP_LasgunDamage</defName>
		<label>lasburn</label>
		<workerClass>DamageWorker_AddInjury</workerClass>
		<armorCategory>Sharp</armorCategory>
		<hediff>Burn</hediff>
		<deathMessage>{0} was blasted with a lasbolt.</deathMessage>
		<impactSoundType>Electric</impactSoundType>
		<defaultArmorPenetration>2.0</defaultArmorPenetration>
		<combatLogRules>Damage_Flame</combatLogRules>
	</DamageDef>
	
    <ThingDef ParentName="CVN_BP_LasgunBase">
        <defName>CVN_BP_Gun_Lasgun</defName>
        <label>Pact lasgun</label>
        <description>The most iconic weapon throughout the entire Imperium of Man, the lasgun comes in too many variants to even attempt recording. Lasguns, while more expensive to produce, have highly reduced strain on logistical networks compared to autoguns.\n\nPact lasguns don't see much modification outside the installation of bayonets.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/BP_Lasrifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		    <drawSize>1.3</drawSize>
        </graphicData>
		<uiIconScale>0.9</uiIconScale>
		<soundInteract>Interact_ChargeRifle</soundInteract>
        <statBases>
            <WorkToMake>42000</WorkToMake>
            <Mass>4</Mass>
            <AccuracyTouch>0.65</AccuracyTouch>
            <AccuracyShort>0.75</AccuracyShort>
            <AccuracyMedium>0.75</AccuracyMedium>
            <AccuracyLong>0.75</AccuracyLong>
            <RangedWeapon_Cooldown>1.50</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>90</Steel>
            <ComponentIndustrial>9</ComponentIndustrial>
        </costList>
        <weaponTags>
            <li>CVN_BP_ranged2</li>
            <li>CVN_BP_Lasguns</li>
        </weaponTags>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Projectile_CVN_BP_Lasgun</defaultProjectile>
                <warmupTime>1.20</warmupTime>
                <range>34.9</range>
                <soundCast>CVN_BP_LasgunFire</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
            </li>
        </verbs>
		<recipeMaker>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
            <recipeUsers Inherit="false">
                <li>CVN_BP_FabricationBench</li>
            </recipeUsers>
            <displayPriority>231</displayPriority>
			<researchPrerequisites>
		     <li>CVN_BP_Plunder</li>
		    </researchPrerequisites>
        </recipeMaker>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>saw bayonet</label>
                <capacities>
                <li>Cut</li>
                </capacities>
                <power>16</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
	
	<ThingDef ParentName="BaseBullet">
        <defName>Projectile_CVN_BP_Lasgun</defName>
        <label>lasbolt</label>
        <description>a laser</description>
        <thingClass>taranchuk_lasers.LaserProjectile</thingClass>
        <drawOffscreen>true</drawOffscreen>
        <seeThroughFog>true</seeThroughFog>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Projectiles/Las_Bolt</texPath>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>1</drawSize>
        </graphicData>
        <projectile>
            <damageDef>CVN_BP_LasgunDamage</damageDef>
            <damageAmountBase>19</damageAmountBase>
            <armorPenetrationBase>0.35</armorPenetrationBase>
            <stoppingPower>0.7</stoppingPower>
            <speed>1000</speed>
        </projectile>
        <modExtensions>
            <li Class="taranchuk_lasers.LaserProperties">
                <damageTickRate>9</damageTickRate>
                <lifetimeTicks>8</lifetimeTicks>
                <beamWidth>1</beamWidth>
                <beamWidthDrawScale>1</beamWidthDrawScale>
                <sweepRatePerTick>0</sweepRatePerTick>
                <maxSweepAngle>0</maxSweepAngle>
                <damageThingsAcrossBeamLine>false</damageThingsAcrossBeamLine>
                <debugCells>false</debugCells>
                <textureScrollOffsetPerTick>(0, -0.1)</textureScrollOffsetPerTick>
                <lockOnTarget>false</lockOnTarget>
            </li>
        </modExtensions>
    </ThingDef>
 
    <ThingDef ParentName="CVN_BP_LasgunBase">
        <defName>CVN_BP_Gun_Laspistol</defName>
        <label>Pact laspistol</label>
        <description>Most commonly seen in the hands of officers or commissars, laspistols are rumoured to see more use in execution then in actual combat.\n\nDue to the Blood Pact's disdain for killing its own members, laspistols are not nearly as common within its ranks as within the Imperial Guard.</description>
