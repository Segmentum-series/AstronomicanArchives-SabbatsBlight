<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <ThingDef ParentName="CVN_BP_ArmorBase">
        <defName>CVN_BP_Apparel_Flakhelm</defName>
        <label>salvaged flak helmet</label>
        <description>An Imperial Guard flak helmet, either taken during desertion, looted from an armoury, or scavenged from the battlefield dead. Repainted in traditional Blood Pact colours.\n\nMade from low-grade ceramite, they offer superior protection compared to the hand-forged Blood Pact Grotesque while lacking in facial protection.</description>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/CorruptedCadian/Headgear/BP_CadianHelmet</texPath>
        </graphicData>
        <costList>
			<Steel>60</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
        </costList>	
        <statBases>
            <WorkToMake>3000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>2</Mass>
            <ArmorRating_Sharp>0.70</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.40</ArmorRating_Blunt>
            <ArmorRating_Heat>0.30</ArmorRating_Heat>
            <Insulation_Cold>2</Insulation_Cold>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
        <recipeMaker>
            <researchPrerequisites>
			 <li>CVN_BP_Plunder</li>
			 <li>FlakArmor</li>
			</researchPrerequisites>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
			<displayPriority>415</displayPriority>
        </recipeMaker>
        <apparel>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/CorruptedCadian/Headgear/BP_CadianHelmet</wornGraphicPath>
            <tags>
                <li>CVN_BP_Apparelhead1</li>
            </tags>
		    <bodyPartGroups>
                <li>UpperHead</li>
            </bodyPartGroups>
            <layers>
                <li>Overhead</li>
            </layers>
        </apparel>
    </ThingDef>
	
	<ThingDef ParentName="CVN_BP_ArmorBase">
        <defName>CVN_BP_Apparel_Flakghelm</defName>
        <label>salvaged gasmask helmet</label>
        <description>An Imperial Guard flak helmet, either taken during desertion, looted from an armory, or scavenged from the battlefield dead. It features a familiar gas mask for added facial protection, while the helmet's fixed spikes can help in melee combat.\n\nMade from low-grade ceramite, they offer superior protection compared to the hand-forged Blood Pact Grotesque helmets.</description>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/Gasmask/Headgear/BP_GenericGasmask</texPath>
        </graphicData>
        <costList>
			<Steel>65</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
        </costList>	
        <statBases>
            <WorkToMake>4000</WorkToMake>
            <MaxHitPoints>220</MaxHitPoints>
            <Mass>2.5</Mass>
            <ArmorRating_Sharp>0.74</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
            <ArmorRating_Heat>0.40</ArmorRating_Heat>
            <Insulation_Cold>4</Insulation_Cold>
            <EquipDelay>1.6</EquipDelay>
        </statBases>
		<equippedStatOffsets>
         <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.75</ToxicEnvironmentResistance>
        </equippedStatOffsets>
        <recipeMaker>
            <researchPrerequisites>
			 <li>CVN_BP_Plunder</li>
			 <li>FlakArmor</li>
			</researchPrerequisites>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
			<displayPriority>415</displayPriority>
        </recipeMaker>
        <apparel>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Gasmask/Headgear/BP_GenericGasmask</wornGraphicPath>
            <tags>
                <li>CVN_BP_Apparelhead1</li>
            </tags>
            <bodyPartGroups Inherit="False">
                <li>FullHead</li>
            </bodyPartGroups>
			<layers>
                <li>Overhead</li>
            </layers>
        </apparel>
    </ThingDef>
	
	<ThingDef ParentName="CVN_BP_ArmorBase">
        <defName>CVN_BP_Apparel_SirdarMaskA</defName>
        <label>Sirdar grotesque grim</label>
        <description>The Grotesque, a facemask featuring a leering grin made of solid metal, affixed to a metal-bound, spiked helmet. Arguably the most iconic symbol of the Pact, it instills a sense of dread in those who face it.\n\nThis particular helmet is painted in dark colours, with round eyes that complement a perverse grin - a horrible sight on the battlefield.</description>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/Sirdar/Headgear/BP_SirdarHelmetA</texPath>
        </graphicData>
        <costList>
			<Steel>80</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
        </costList>	
        <statBases>
            <WorkToMake>5000</WorkToMake>
            <MaxHitPoints>250</MaxHitPoints>
            <Mass>6</Mass>
            <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
            <ArmorRating_Heat>0.50</ArmorRating_Heat>
            <Insulation_Cold>5</Insulation_Cold>
            <EquipDelay>2.5</EquipDelay>
        </statBases>
	    <equippedStatOffsets> 
         <PainShockThreshold>0.05</PainShockThreshold>
        </equippedStatOffsets>
        <recipeMaker>
            <researchPrerequisites>
			 <li>CVN_BP_Basic</li>
			 <li>PlateArmor</li>
			</researchPrerequisites>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
			<displayPriority>415</displayPriority>
        </recipeMaker>
        <apparel>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Sirdar/Headgear/BP_SirdarHelmetA</wornGraphicPath>
            <bodyPartGroups Inherit="False">
                <li>FullHead</li>
            </bodyPartGroups>
            <tags>
                <li>CVN_BP_Apparelhead2</li>
            </tags>
			<layers>
                <li>Overhead</li>
            </layers>
        </apparel>
    </ThingDef>
	
