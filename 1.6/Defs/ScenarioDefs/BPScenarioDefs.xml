	<ScenPartDef>
		<defName>CVN_BP_ConfigurePawnsKindDefs</defName>
		<label>starting people</label>
		<scenPartClass>ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs</scenPartClass>
		<selectionWeight>0</selectionWeight>
		<pageClass>Page_ConfigureStartingPawns</pageClass>
		<summaryPriority>510</summaryPriority>
		<category>Fixed</category>
	</ScenPartDef>

  <ScenarioDef Name="BPstart" ParentName="ScenarioBase">
    <defName>CVN_BP_WageWarForTheGods</defName>
    <label>Wage War for the Gods</label>
    <description>Driven from the Sabbat Worlds, you became lost during efforts to regroup with the local Etogaur. Somehow, your warband has arrived on this distant world, a feral place that reminds you of Ghourra.\n\nThere are signs of the false believers having been here, but they lack control and thus cannot drive you out easily. As it stands, your numbers are low - three mere initiates yet to even cut their flesh upon the Archon's armor, a Warrior, and a sole Sirdar to lead you.\n\nLocal tribes already revere blood gods and other such forces. As such, recruitment should prove simple - rebuild your forces and take this world in the name of your Archon.</description>
    <scenario>
		<playerFaction>
			<factionDef>CVN_BP_Bloodpact_Player</factionDef>
		</playerFaction>
		<summary>A wayward warband led by a Sirdar, intent on recruiting followers to the Blood Pact, and conquering this world for the Warlord of the Sabbat Sector.</summary>
		<parts>
        
		<!-- Config pages -->
		<li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
			<def>CVN_BP_ConfigurePawnsKindDefs</def>
			<pawnChoiceCount>5</pawnChoiceCount>
			<leftBehindPawnKind>CVN_BP_ScenarioPawnKind_Initiate</leftBehindPawnKind>
			<kindCounts>
				<li>
					<kindDef>CVN_BP_ScenarioPawnKind_Sirdar</kindDef>
					<count>1</count>
					<requiredAtStart>true</requiredAtStart>
				</li>
				<li>
					<kindDef>CVN_BP_ScenarioPawnKind_Warrior</kindDef>
					<count>1</count>
					<requiredAtStart>true</requiredAtStart>
				</li>
				<li>
					<kindDef>CVN_BP_ScenarioPawnKind_Initiate</kindDef>
					<count>3</count>
					<requiredAtStart>true</requiredAtStart>
				</li>
			</kindCounts>
		</li>

        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
          <visible>false</visible>
        </li>

        <!-- Player pawns modifiers -->
        
        <!-- Player starting things -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>15</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>25</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>CVN_BP_Gun_Autocarbine</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>CVN_BP_Gun_AutoPistol</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>CVN_BP_MeleeWeapon_TrenchClub</thingDef>
          <stuff>Steel</stuff>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>CVN_BP_Gun_Lasgun</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>CVN_BP_MeleeWeapon_SabreKnife</thingDef>
          <stuff>Steel</stuff>
        </li>

        <!-- Scatter some things near player start -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>250</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>      

        <!-- Scatter some things anywhere -->
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>ShipChunk</thingDef>
          <allowRoofed>false</allowRoofed>
          <count>5</count>
        </li>
        
        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Driven from the Sabbat Worlds, you became lost during efforts to regroup with the local Etogaur. Somehow, your warband has arrived on this distant world, a feral place that reminds you of Ghourra.\n\nThere are signs of the false believers having been here, but they lack control and thus cannot drive you out easily. As it stands, your numbers are low - three mere initiates yet to even cut their flesh upon the Archon's armor, a Warrior, and a sole Sirdar to lead you.\n\nLocal tribes already revere blood gods and other such forces. As such, recruitment should prove simple - rebuild your forces and take this world in the name of your Archon.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
        
      </parts>
    </scenario>
  </ScenarioDef>
	
</Defs>
