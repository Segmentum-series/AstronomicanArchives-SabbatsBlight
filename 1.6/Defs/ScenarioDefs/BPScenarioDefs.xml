<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Sirdar -->
	<PawnKindDef ParentName="BasePlayerPawnKind">
		<defName>CVN_BP_ScenarioPawnKind_Sirdar</defName>
		<label>Sirdar</label>
		<defaultFactionType>CVN_BP_Bloodpact_Player</defaultFactionType>
		<race>Human</race>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<apparelTags Inherit="False">
			<!-- <li>?</li> -->
		</apparelTags>
		<apparelRequired Inherit="False">
			<li>CVN_BP_Apparel_Fatigues</li>
			<li>CVN_BP_Apparel_SirdarMaskA</li>
			<li>CVN_BP_Apparel_SirdarArmorB</li>
		</apparelRequired>
		<ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
		<initialWillRange>0~0</initialWillRange>
		<apparelMoney>0~0</apparelMoney>
		<techHediffsChance>0</techHediffsChance>
		<techHediffsMoney>1000~2500</techHediffsMoney>
		<techHediffsMaxAmount>2</techHediffsMaxAmount>
		<initialResistanceRange>13~21</initialResistanceRange>
		<humanPregnancyChance>0</humanPregnancyChance>
		<backstoryFiltersOverride>
			<li>
			<categoriesChildhood>
				<li>CVN_BP_BloodPactWarriorBackstories</li>
				<li>CVN_BP_BloodPactSirdarBackstories</li>
			</categoriesChildhood>
			<categoriesAdulthood>
				<li>CVN_BP_BloodPactSirdarBackstories</li>
			</categoriesAdulthood>
			</li>
		</backstoryFiltersOverride>
	</PawnKindDef>

