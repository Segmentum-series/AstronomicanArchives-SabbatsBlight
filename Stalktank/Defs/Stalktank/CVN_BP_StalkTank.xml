    <ThingDef ParentName="BaseMechanoid">
        <defName>StalkTank</defName>
        <label>Stalk Tank</label>
        <description>A small and nimble Dameonengine, of native Sabbat design. Armed with a lasgun and machinegun, it is a cheap way to add armour and spread terror.</description>
        <size>(5, 6)</size>
        <statBases>
            <UF_FlightSpeed>190</UF_FlightSpeed>
            <UF_FlightControl>1</UF_FlightControl>
        </statBases>
        <tools>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
            <li>
                <label>claw</label>
                <capacities>
                    <li>Cut</li>
                </capacities>
                <power>28</power>
                <cooldownTime>3.78</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.8</chanceFactor>
            </li>
        </tools>
        <race>
            <body>CVN_Stalktankframe</body>
            <baseHealthScale>2.5</baseHealthScale>
            <soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss>
            <intelligence>ToolUser</intelligence>
            <thinkTreeMain>MechSuit</thinkTreeMain>
            <baseBodySize>2.0</baseBodySize>
            <lifeStageAges>
                <li>
                    <def>MechanoidFullyFormed</def>
                    <minAge>0</minAge>
                    <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
                    <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
                    <soundCall>Pawn_Mech_Scyther_Call</soundCall>
                </li>
            </lifeStageAges>
        </race>
        <butcherProducts>
            <Steel>30</Steel>
            <Plasteel>5</Plasteel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </butcherProducts>
        <inspectorTabs>
            <li>taranchuk_mechsuits.ITab_MechSuit</li>
            <li>taranchuk_mechsuits.ITab_MechSuitWork</li>
        </inspectorTabs>
        <comps Inherit="False">
            <li Class="taranchuk_mechsuits.CompProperties_MechSuit">
                <requiresPilot>true</requiresPilot>
                <canBePilotedByPawns>true</canBePilotedByPawns>
                <standIfNotMoving>true</standIfNotMoving>
                <workTypes>
                    <li>Hauling</li>
                </workTypes>
                <overridenSkillLevels>
                    <Shooting>7</Shooting>
                    <Melee>4</Melee>
                </overridenSkillLevels>
                <basePowerGeneration>50</basePowerGeneration>
                <basePilotCapacity>1</basePilotCapacity>
                <basePassengerCapacity>0</basePassengerCapacity>
                <baseCarryingCapacity>1000</baseCarryingCapacity>

                <requiresGantryForModifications>False</requiresGantryForModifications>
                <requiresGantryForConstruction>False</requiresGantryForConstruction>
                <repairable>true</repairable>
                <requireGantryRepair>false</requireGantryRepair>

                <designationCategory>Security</designationCategory>
                <costList>
                    <Steel>250</Steel>
                    <ComponentIndustrial>30</ComponentIndustrial>
                </costList>
                <researchPrerequisites>
                    <li>MicroelectronicsBasics</li>
                    <li>CVN_BP_Vanguard</li>
                </researchPrerequisites>
                <statBases>
                    <WorkToBuild>8000</WorkToBuild>
                    <MaxHitPoints>200</MaxHitPoints>
                    <Flammability>0.5</Flammability>
                </statBases>
            </li>
            <li Class="Taranchuk_ColorPicker.CompProperties_ColorPicker">
                <includeColorTwo>true</includeColorTwo>
                <label>Mech Personalized Paint</label>
                <description>Mech Personalized Paint</description>
                <iconPath>UI/PaintIcon_weapon</iconPath>
            </li>
        </comps>
    </ThingDef>

