<Defs>

    <!-- Lasgun mouth MechComponent-->
    <taranchuk_mechsuits.MechComponentDef ParentName="CVN_MechComponentBase">
        <defName>CVN_StalkTank_Lasgun</defName>
        <label>multi-laser</label>
        <description>The multi-laser is a type of las weapon with less penetrative power than the larger lascannon but can deliver barrages of lasbolts at high velocity. This one is designed to be mounted on a stalk tank.</description>

        <graphicData>
            <texPath>Things/Pawn/StalkTank/Flammer_Chin_SubGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>2</drawSize>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <drawOnMech>True</drawOnMech>

        <slotTags>
            <li>H_Lasgun</li>
        </slotTags>

        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>10</ComponentIndustrial>
        </costList>
        <comps>
            <li>
                <compClass>CompEquippable</compClass>
            </li>
            <li Class="taranchuk_mechsuits.CompProperties_MechCompTurret">
                <turretDef>CVN_Stalktank_LasgunTurret</turretDef>
                <canRotate>true</canRotate>
            </li>
        </comps>
    </taranchuk_mechsuits.MechComponentDef>

    <!-- Lasgun mouth turret -->
    <ThingDef ParentName="BaseWeaponTurret">
        <defName>CVN_Stalktank_LasgunTurret</defName>
        <label>multi-laser head turret</label>
        <description>A turret mounted on the stalk tank's head. The multi-laser is a type of las weapon with less penetrative power than the larger lascannon but can deliver barrages of lasbolts at high velocity.</description>
        <tradeability>None</tradeability>
        <destroyOnDrop>true</destroyOnDrop>
        <graphicData>
            <texPath>Things/Pawn/StalkTank/Flammer_Chin_SubGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>2500</WorkToMake>
            <Mass>3.4</Mass>
            <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
            <Flammability>0.7</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Projectile_CVN_BP_Longlas</defaultProjectile>
                <warmupTime>3.50</warmupTime>
                <range>44.9</range>
                <soundCast>CVN_BP_LasgunFire</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <burstShotCount>10</burstShotCount>
                <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
                <muzzleFlashScale>12</muzzleFlashScale>
            </li>
        </verbs>
        <comps>
        </comps>
    </ThingDef>

    <!-- Flamethrower mouth turret -->
    <ThingDef ParentName="BaseWeaponTurret">
        <defName>CVN_Stalktank_FlamethrowerTurret</defName>
        <label>flamethrower head turret</label>
        <description>A turret mounted on the stalk tank's head. It can project burning promethium that consumes anyone and anything unfortunate enough to be in its way.</description>
        <tradeability>None</tradeability>
        <destroyOnDrop>true</destroyOnDrop>
        <graphicData>
            <texPath>Things/Pawn/StalkTank/Flammer_Chin_SubGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>2500</WorkToMake>
            <Mass>3.4</Mass>
            <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
            <Flammability>0.7</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_IncendiaryLauncher</defaultProjectile>
                <warmupTime>3.5</warmupTime>
                <range>19.9</range>
                <forcedMissRadius>1.9</forcedMissRadius>
                <burstShotCount>100</burstShotCount>
                <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
                <soundCast>Shot_IncendiaryLauncher</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>1</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
        <comps>
        </comps>
    </ThingDef>


    <!-- Machinegun main turret MechComponent-->
    <taranchuk_mechsuits.MechComponentDef ParentName="CVN_MechComponentBase">
        <defName>CVN_Stalktank_Machinegun</defName>
        <label>twin heavy stubbers</label>
        <description>Twin heavy stubbers can project a devastating storm of bullets at anyone foolish enough to challenge the might of Urdesh's forges. This gun is designed to be mounted on a stalk tank.</description>

        <graphicData>
            <texPath>Things/Pawn/StalkTank/DualMG_MainGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>2</drawSize>
        </graphicData>
        <drawOnMech>True</drawOnMech>

        <slotTags>
            <li>CVN_BP_Turret</li>
        </slotTags>

        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>30</ComponentIndustrial>
        </costList>
        <comps>
            <li>
                <compClass>CompEquippable</compClass>
            </li>
            <li Class="taranchuk_mechsuits.CompProperties_MechCompTurret">
                <turretDef>CVN_Stalktank_MachinegunTurret</turretDef>
                <canRotate>true</canRotate>
            </li>
        </comps>
    </taranchuk_mechsuits.MechComponentDef>

    <!-- Machinegun main turret -->
    <ThingDef ParentName="BaseWeaponTurret">
        <defName>CVN_Stalktank_MachinegunTurret</defName>
        <label>twin heavy stubber turret</label>
        <description>A turret mounted on the back of the stalk tank. Twin heavy stubbers project a devastating storm of bullets at anyone foolish enough to challenge the might of Urdesh's forges.</description>
        <tradeability>None</tradeability>
        <destroyOnDrop>true</destroyOnDrop>
        <graphicData>
            <texPath>Things/Pawn/StalkTank/DualMG_MainGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>2500</WorkToMake>
            <Mass>10</Mass>
            <AccuracyTouch>0.2</AccuracyTouch>
            <AccuracyShort>0.25</AccuracyShort>
            <AccuracyMedium>0.25</AccuracyMedium>
            <AccuracyLong>0.18</AccuracyLong>
            <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_Minigun</defaultProjectile>
                <warmupTime>2.5</warmupTime>
                <range>30.9</range>
                <burstShotCount>30</burstShotCount>
                <ticksBetweenBurstShots>2</ticksBetweenBurstShots>
                <soundCast>Shot_Minigun</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <comps>
        </comps>
    </ThingDef>

</Defs>