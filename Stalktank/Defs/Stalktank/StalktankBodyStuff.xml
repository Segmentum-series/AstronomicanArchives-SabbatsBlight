              <shootingArcMinAngle>-30.0</shootingArcMinAngle>
              <shootingArcMaxAngle>30.0</shootingArcMaxAngle>
              <defaultTurretAngleOffset>270.0</defaultTurretAngleOffset>
            </li>
          </slots>
        </li>
        <li Class="taranchuk_mechsuits.MechPart">
          <partID>LegFrontRight</partID>
