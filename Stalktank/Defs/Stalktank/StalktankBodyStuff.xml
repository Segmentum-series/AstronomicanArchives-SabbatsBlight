              <partID>Head</partID>
              <def>InsectHead</def>
              <coverage>0.65</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>HeadAttackTool</li>
              </groups>
              <slots>
                <li>
                  <label>System Slot 1</label>
                  <slotID>System1</slotID>
