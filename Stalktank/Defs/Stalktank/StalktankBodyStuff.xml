      <partID>Torso</partID>
      <def>Shell</def>
      <coverage>1.00</coverage>
      <height>Middle</height>
      <depth>Outside</depth>
      <slots>
        <li>
          <label>Power Source</label>
          <slotID>PowerSource</slotID>
          <tags>
            <li>Reactor</li>
          </tags>
        </li>
        <li>
          <label>Plating</label>
          <slotID>TorsoPlating</slotID>
          <tags>
            <li>Plating</li>
          </tags>
        </li>
      </slots>
      <parts>
        <li>
          <def>Elytra</def>
          <customLabel>left elytra</customLabel>
          <coverage>0.05</coverage>
          <height>Middle</height>
          <depth>Outside</depth>
        </li>
        <li>
          <def>Elytra</def>
          <customLabel>right elytra</customLabel>
          <coverage>0.05</coverage>
          <height>Middle</height>
          <depth>Outside</depth>
