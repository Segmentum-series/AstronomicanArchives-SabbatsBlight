                <li>
                  <def>InsectNostril</def>
                  <coverage>0.06</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                </li>
                <li Class="taranchuk_mechsuits.MechPart">
                  <partID>Mouth</partID>
