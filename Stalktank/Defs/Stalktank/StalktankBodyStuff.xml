          <coverage>0.05</coverage>
          <height>Middle</height>
          <depth>Inside</depth>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.03</coverage>
          <height>Middle</height>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Pronotum</def>
          <coverage>0.18</coverage>
          <height>Top</height>
          <depth>Outside</depth>
